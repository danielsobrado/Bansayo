; Bansayo training room — same wire coordinates as the engine.
config_version=5

[application]
config/name="Bansayo Training Room"
run/main_scene="res://training_room.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.06, 1)

[xr]
openxr/enabled=true
shaders/enabled=true

[bansayo]
engine_url="http://127.0.0.1:7700"
xr_uplink_enabled=false
xr_uplink_rate_hz=60
xr_uplink_max_buffered_bytes=8192
xr_uplink_reconnect_initial_ms=500
xr_uplink_reconnect_max_ms=8000
