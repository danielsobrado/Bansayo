<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- LAN mode has no TLS (ADR-031 item 4): cleartext to the engine on the home network only. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Bansayo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Pairing link shown as a QR code on the desktop: bansayo://pair?host=&port=&token=
                 (forwarded to SettingsActivity, keeping Home underneath it). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bansayo" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- Landscape, so frames arrive as the engine's declared 1280x720. -->
        <activity
            android:name=".CameraActivity"
            android:exported="false"
            android:keepScreenOn="true"
            android:screenOrientation="landscape" />
        <activity android:name=".ViewerActivity" android:exported="false" android:keepScreenOn="true" />
        <activity android:name=".TrainingHistoryActivity" android:exported="false" />
        <activity android:name=".AdminActivity" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
